flowchart TB
  start((" ")) -->|"ticket received"| NA(["<b>not_applicable</b>"])
  NA -->|"triaged reportable,<br/>no fix time (final report)"| AF(["<b>awaiting_fix</b><br/>final report, no fix time yet"])
  NA ---->|"triaged reportable,<br/>due time ahead"| P(["<b>pending</b><br/>not recorded, due time ahead"])
  AF -->|"fix recorded,<br/>due time ahead"| P
  AF -->|"fix recorded,<br/>due time passed"| O(["<b>overdue</b><br/>not recorded, past due time"])
  NA -->|"triaged reportable,<br/>due time already passed"| O
  P -->|"due time passes,<br/>or moves earlier †"| O
  P -->|"fix time cleared<br/>(final report)"| AF
  O -->|"fix time cleared<br/>(final report)"| AF
  O -->|"due time moves later *"| P
  P -->|"recorded"| S(["<b>submitted</b><br/>recorded at or before due time"])
  O -->|"recorded after due time"| SL(["<b>submitted_late</b><br/>recorded after due time"])
  O -->|"recorded with a submitted_at<br/>at or before due time"| S
  S -->|"due time moves earlier **"| SL
  SL -->|"due time moves later **"| S
  subgraph legend["Legend"]
    direction TB
    l1["Status is never stored; it is recalculated on every read from the stored times,<br/>the recorded submitted_at (if any), and the current (or fixed test) time."]
    l2["* awareness or fix time changed, or the test clock set back"]
    l4["† awareness or fix time moved earlier"]
    l3["** awareness or fix time changed (pod question Q4). Moving the clock never changes<br/>a recorded status. A recorded final report whose fix time is cleared counts as submitted."]
  end
  S ~~~ legend
  SL ~~~ legend
  classDef state fill:#eef3fb,stroke:#3b5b8c,color:#111
  classDef note fill:#ffffff,stroke:#999,color:#333
  class NA,AF,P,O,S,SL state
  class l1,l2,l3,l4 note
